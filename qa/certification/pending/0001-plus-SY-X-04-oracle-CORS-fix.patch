-EvaluateRequest.max_length=500. A literal 500-term sum is ~999 characters
-and is rejected at the Pydantic validation boundary (422 VALIDATION_ERROR)
-before any CAS work. This test certifies that contract behaviour and, in a
-second case, that a sum which does fit the contract produces the expected
-equivalent result.
-
-Classification: PASS (scoped request-length contract + functional subset).
-Does not claim unrestricted 500-term HTTP evaluation.
+Two independent contracts bound this input class:
+  * EvaluateRequest.max_length=500 -- a literal 500-term sum is ~999 chars
+    and is rejected at the Pydantic validation boundary (422
+    VALIDATION_ERROR) before any CAS work.
+  * ast_validator.MAX_AST_NODES=200 (Etapa 9 seccion 7) -- parsed with
+    evaluate=False, an n-term flat sum has n Symbol nodes plus one Add
+    node; n=200 reaches 201 nodes and is rejected as COMPLEXITY_LIMIT.
+
+This module certifies all three regimes on the real HTTP channel:
+oversize rejection (422), complexity-boundary rejection (COMPLEXITY_LIMIT
+at exactly 200 terms) and functional success below the boundary
+(199 terms -> 199*x).
+
+Classification: PASS (scoped length contract + AST-node boundary +
+functional subset). Does not claim unrestricted 500-term HTTP evaluation.
 """
 import pytest
 from fastapi.testclient import TestClient
@@ -45,10 +52,30 @@ def test_sy_x04_five_hundred_term_sum_rejected_at_request_length_boundary():
     assert "traceback" not in response.text.lower()
 
 
+def test_sy_x04_two_hundred_term_sum_hits_ast_node_complexity_limit():
+    """Exactly 200 terms (399 chars, within max_length) exceeds the
+    MAX_AST_NODES=200 contract (201 nodes) -> controlled COMPLEXITY_LIMIT,
+    HTTP 200 with success=false. Product behaviour per Etapa 9 §7."""
+    expression = _n_term_sum(200)
+    assert len(expression) <= 500, len(expression)
+
+    response = client.post(
+        "/api/v1/evaluate",
+        json={"expression": expression, "angle_unit": "rad"},
+    )
+    assert response.status_code == 200, response.text[:300]
+    body = response.json()
+    assert body.get("success") is False, body
+    assert body.get("error_code") == "COMPLEXITY_LIMIT", body
+    assert "200" in str(body.get("error_message")), body
+    assert "traceback" not in response.text.lower()
+
+
 def test_sy_x04_functional_subset_within_length_contract_yields_nx():
-    """A sum that fits max_length=500 must simplify to N*x (or equivalent)."""
-    # 200 terms → "x+"*199 + "x" = 399 chars, safely under 500.
-    n = 200
+    """A sum inside BOTH contracts (length <=500, AST nodes <=200) must
+    simplify to N*x. Maximal such case: 199 terms = 200 nodes."""
+    # 199 terms -> "x+"*198 + "x" = 397 chars; 199 Symbols + 1 Add = 200 nodes.
+    n = 199
     expression = _n_term_sum(n)
     assert len(expression) <= 500, len(expression)
 
