+"""Pytest bootstrap for the backend suite — ORACLE/HARNESS layer.
+
+Every HTTP test module pins CORS via `os.environ.setdefault("CORS_ORIGINS", ...)`
+before importing `app.main`. Because Settings caches per process and pytest runs
+all modules in one process, the FIRST module alphabetically wins: S25
+(test_s25_deployment_security.py) asserted an origin that earlier modules
+(test_algebra.py, test_evaluate.py, ...) had already pinned to a different value,
+so the full-suite run failed with order-dependent 403/CORS round-trip errors
+while isolated runs passed. This conftest establishes a canonical test allow-list
+BEFORE any module import (conftest is loaded first by pytest); the per-module
+setdefault() calls then become no-ops and every assertion keeps holding because
+each pinned origin is included here.
+"""
+import os
+
+_CANONICAL_TEST_ORIGINS = ",".join(
+    [
+        "http://localhost:5173",          # dev frontend + generic suites
+        "https://security-test.example",  # S25 deployment-security asserts
+    ]
+)
+
+_existing = os.environ.get("CORS_ORIGINS")
+if _existing:
+    if "http://localhost:5173" not in _existing:
+        _existing += ",http://localhost:5173"
+    if "https://security-test.example" not in _existing:
+        _existing += ",https://security-test.example"
+    os.environ["CORS_ORIGINS"] = _existing
+else:
+    os.environ["CORS_ORIGINS"] = _CANONICAL_TEST_ORIGINS
