{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "stryker.vitest.config.ts"
  },
  "mutate": [
    "src/components/fractionDisplay.ts",
    "src/utils/unitConversion.ts"
  ],
  "coverageAnalysis": "all",
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 15.3
  },
  "timeoutMS": 15000,
  "timeoutFactor": 2,
  "concurrency": 4,
  "ignoreStatic": false,
  "disableTypeChecks": "{test,src}/**/*.{js,ts,jsx,tsx}"
}
