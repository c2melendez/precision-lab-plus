{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/components/NaturalMathField.tsx",
    "src/components/calculusIntent.ts",
    "src/components/systemSplit.ts",
    "src/components/fractionDisplay.ts",
    "src/utils/unitConversion.ts",
    "src/store/useHistoryStore.ts",
    "src/store/useRecentKeysStore.ts",
    "src/components/KeyboardBasicPanel.tsx"
  ],
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 15.3
  },
  "timeoutMS": 15000,
  "concurrency": 2
}
